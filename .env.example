# SEA-LION uses an OpenAI-compatible chat completions API.
SEALION_API_KEY=
SEALION_BASE_URL=https://api.sea-lion.ai/v1
SEALION_MODEL=aisingapore/Gemma-SEA-LION-v4-27B-IT
SEALION_INITIAL_TIMEOUT_MS=25000
SEALION_TRANSFORM_TIMEOUT_MS=15000

# Optional in local development. Without it, the app uses its in-memory store.
DATABASE_URL=
