# SEA-LION uses an OpenAI-compatible chat completions API.
SEALION_API_KEY=
SEALION_BASE_URL=https://api.sea-lion.ai/v1
SEALION_MODEL=aisingapore/Gemma-SEA-LION-v4-27B-IT
SEALION_INITIAL_TIMEOUT_MS=25000
SEALION_TRANSFORM_TIMEOUT_MS=15000

# Railway app service: reference the Postgres service's DATABASE_URL.
# Local machine: DATABASE_PUBLIC_URL also works when public TCP access is enabled.
# Production refuses to use temporary memory when neither URL is configured.
DATABASE_URL=
DATABASE_PUBLIC_URL=
DATABASE_REQUIRED=0
